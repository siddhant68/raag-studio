# This file is documentation; scripts do not automatically execute .env files.
# Export the values you need in the terminal before starting Raag Studio.
# Folder layout: $RAAG_TOOLS_DIR/acestep-venv/bin/python and ace-step-1.5/checkpoints/.
# export RAAG_TOOLS_DIR="$PWD/runtime"
# export RAAG_PORT=8477
# export RAAG_DATA_DIR="$PWD/data"
# export RAAG_RUNS_DIR="$PWD/runs"
# export RAAG_VIDEO_QUEUE_URL=http://127.0.0.1:8388/queue
# Optional API planner: enable it separately in the app's Settings.
# export ANTHROPIC_API_KEY=your_key_here
# RAAG_ENGINE=fake is for interface development/tests only, never real music.
